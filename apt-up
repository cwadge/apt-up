Set_BASH_Options
Load_Config
Parse_Arguments "$@"
Initialize_Logging
Detect_Bin_Paths
Sanity_Check
Apply_Resource_Limits

# Only show the export section if there is something to export
if [ -n "$EXPORT_VARS" ] || [ "$DRY_RUN" = "true" ]; then
	Print_Header "Exporting global variables..."
	CURRENT_STEP="exporting global variables"
	for CURRENT_EXPORT in ${EXPORT_VARS}; do
		cecho "[INFO] Exporting: ${CURRENT_EXPORT}" cyan
		export "${CURRENT_EXPORT?}"
	done
	if [ "$DRY_RUN" = "true" ]; then
		export IS_DRY_RUN=true
		cecho "[INFO] Exporting: IS_DRY_RUN=true (for hook scripts)" cyan
