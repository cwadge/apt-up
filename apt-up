#!/bin/bash
# shellcheck disable=SC2086

## VARIABLES ##
# Configuration file path
CONFIG_FILE="/etc/apt-up.conf"

# Default values (may be overridden by config file)
# Variables to export during update (space-separated list):
EXPORT_VARS="IGNORE_CC_MISMATCH=1"
# Defaults to GitLab kernel-firmware, which is upstream of kernel.org,
# but the kernel.org git is a more heavily scrutinized and conservative option:
# https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git
FIRMWARE_GIT_URL="https://gitlab.com/kernel-firmware/linux-firmware.git"

# Feature toggles
ENABLE_FIRMWARE_UPDATE=true
ENABLE_SYSTEM_UPDATE=true
ENABLE_DIST_UPGRADE=false
ENABLE_FLATPAK_UPDATE=true
ENABLE_KERNEL_CLEANUP=true
ENABLE_CACHE_CLEAN=true
ENABLE_HOOKS=true

# Operation mode
INTERACTIVE=true
DRY_RUN=false
DRY_RUN_HOOKS=true     # Execute hooks in dry-run mode (IS_DRY_RUN=true is exported to them)

# Resource management (only applicable to non-interactive mode)
NICE_LEVEL=10
USE_IONICE=true
IONICE_CLASS=2
IONICE_LEVEL=7

# Hooks directory
# NOTE: Errors executing scripts with 'critical' in the title are treated as fatal
HOOKS_DIR="/etc/apt-up.d"

# Logging
LOG_FILE="/var/log/apt-up.log"
ENABLE_LOGGING=false

## BINARIES ##
# Leave blank for auto-detection:
DPKGBIN=""
APTBIN=""
APTGETBIN=""
APTITUDEBIN=""
FLATPAKBIN=""
GITBIN=""

## FUNCTIONS ##
# Begin color handling functions #
export black='\033[0m'
export boldblack='\033[1;0m'
export red='\033[31m'
export boldred='\033[1;31m'
export green='\033[32m'
export boldgreen='\033[1;32m'
export yellow='\033[33m'
export boldyellow='\033[1;33m'
export blue='\033[34m'
export boldblue='\033[1;34m'
export magenta='\033[35m'
export boldmagenta='\033[1;35m'
export cyan='\033[36m'
export boldcyan='\033[1;36m'
export white='\033[37m'
export boldwhite='\033[1;37m'

cecho ()
{
	local default_msg=" "
	message=${1:-$default_msg}
	color=${2:-black}
	case $color in
		black) printf '%b' "$black" ;;
		boldblack) printf '%b' "$boldblack" ;;
		red) printf '%b' "$red" ;;
		boldred) printf '%b' "$boldred" ;;
		green) printf '%b' "$green" ;;
		boldgreen) printf '%b' "$boldgreen" ;;
		yellow) printf '%b' "$yellow" ;;
		boldyellow) printf '%b' "$boldyellow" ;;
		blue) printf '%b' "$blue" ;;
		boldblue) printf '%b' "$boldblue" ;;
		magenta) printf '%b' "$magenta" ;;
		boldmagenta) printf '%b' "$boldmagenta" ;;
		cyan) printf '%b' "$cyan" ;;
		boldcyan) printf '%b' "$boldcyan" ;;
		white) printf '%b' "$white" ;;
		boldwhite) printf '%b' "$boldwhite" ;;
	esac
	printf "%s\n" "$message"
	tput sgr0
	printf '%b' "$black"
	# Log to file if enabled
	if [ "$ENABLE_LOGGING" = "true" ]; then
		echo "[$(date '+%Y-%m-%d %H:%M:%S')] $message" >> "$LOG_FILE"
	fi
	return
}
# End color handling functions #

# Begin border functions #
Print_Header() {
	local message="$1"
	local color="${2:-boldblue}"
	local total_width=66  # Total width of the box with border characters
	local content_width=64  # Width between the ║ characters

	# Calculate padding
	local msg_len=${#message}
	local padding_total=$((content_width - msg_len))
	local padding_left=$((padding_total / 2))
	local padding_right=$((padding_total - padding_left))

	# Set color based on parameter
	case $color in
		black) printf '%b' "$black" ;;
		boldblack) printf '%b' "$boldblack" ;;
		red) printf '%b' "$red" ;;
		boldred) printf '%b' "$boldred" ;;
		green) printf '%b' "$green" ;;
		boldgreen) printf '%b' "$boldgreen" ;;
		yellow) printf '%b' "$yellow" ;;
		boldyellow) printf '%b' "$boldyellow" ;;
		blue) printf '%b' "$blue" ;;
		boldblue) printf '%b' "$boldblue" ;;
		magenta) printf '%b' "$magenta" ;;
		boldmagenta) printf '%b' "$boldmagenta" ;;
		cyan) printf '%b' "$cyan" ;;
		boldcyan) printf '%b' "$boldcyan" ;;
		white) printf '%b' "$white" ;;
		boldwhite) printf '%b' "$boldwhite" ;;
	esac

	# Print the header
	printf "╔════════════════════════════════════════════════════════════════╗\n"
	printf "║%*s%s%*s║\n" $padding_left "" "$message" $padding_right ""
	printf "╚════════════════════════════════════════════════════════════════╝\n"

	# Reset color
	tput sgr0
	printf '%b' "$black"
}
# End border functions #

Error_Handler ()
{
	cecho "[FATAL] Script aborted while $CURRENT_STEP." boldred
	echo
	# Run failure hooks if enabled
	if [ "$ENABLE_HOOKS" = "true" ]; then
		Run_Hooks "fail"
	fi
	exit 1
}

Bypass_Handler ()
{
	: # Miss the error handler and continue silently
}

Warn_Handler ()
{
	cecho "[WARNING] Something unexpected happened while $CURRENT_STEP." boldyellow
	cecho "[INFO] Continuing anyway..." cyan
}

Set_BASH_Options ()
{
	CURRENT_STEP="setting BASH options"
	if [ -z "$BASH_VERSION" ]; then
		echo
		cecho "[WARNING] This script wasn't run in BASH (are you launching it with 'sh'?)" boldyellow
		cecho "          It may function, but certain error handling won't be as robust." boldyellow
		echo
		if [ "$INTERACTIVE" = "true" ]; then
			read -r -p "==> Continue anyway? [N/y] " REPLY
			case "$REPLY" in
				( [yY]|[yY][eE][sS] ) echo "" ;;
				*) echo ; Error_Handler ;;
			esac
		else
			cecho "[INFO] Running in non-interactive mode, continuing despite non-BASH shell." cyan
		fi
	else
		set -o pipefail
		trap 'Error_Handler' ERR
	fi
}

Show_Help() {
	cat << EOF
apt-up - Comprehensive update script for Debian-based systems

Usage: apt-up [OPTIONS]

Options:
  --no-interactive     Run without user interaction
  --no-firmware        Skip firmware updates
  --no-update-system   Skip system package updates
  --no-dist-upgrade    Skip distribution upgrade
  --no-flatpak         Skip Flatpak updates
  --no-kernel-cleanup  Skip removal of old kernels
  --no-cache-clean     Skip cleaning package caches
  --no-hooks           Skip running hook scripts
  --interactive        Run the script in interactive mode
  --update-firmware    Update system firmware
  --update-system      Update system packages
  --dist-upgrade       Perform distribution upgrade (uses apt instead of aptitude)
  --update-flatpak     Perform Flatpak updates
  --kernel-cleanup     Remove old kernels and headers
  --cache-clean        Clean all apt package caches
  --run-hooks          Run scripts in hook directories
  --dry-run            Show what would be done without making changes
  --dry-run-hooks      Run hook scripts in dry-run mode (default; IS_DRY_RUN=true is exported)
  --no-dry-run-hooks   List hooks in dry-run mode but do not execute them
  --install            Create configuration files and hook directories
  --help               Display this help message

For more information, see the configuration file at /etc/apt-up.conf
EOF
}

Parse_Arguments() {
	CURRENT_STEP="parsing command line arguments"
	for arg in "$@"; do
		case "$arg" in
			"--no-interactive") INTERACTIVE=false ;;
			"--no-firmware") ENABLE_FIRMWARE_UPDATE=false ;;
			"--no-update-system") ENABLE_SYSTEM_UPDATE=false ;;
			"--no-dist-upgrade") ENABLE_DIST_UPGRADE=false ;;
			"--no-flatpak") ENABLE_FLATPAK_UPDATE=false ;;
			"--no-kernel-cleanup") ENABLE_KERNEL_CLEANUP=false ;;
			"--no-cache-clean") ENABLE_CACHE_CLEAN=false ;;
			"--no-hooks") ENABLE_HOOKS=false ;;
			"--interactive") INTERACTIVE=true ;;
			"--update-firmware") ENABLE_FIRMWARE_UPDATE=true ;;
			"--update-system") ENABLE_SYSTEM_UPDATE=true ;;
			"--dist-upgrade") ENABLE_DIST_UPGRADE=true ;;
			"--update-flatpak") ENABLE_FLATPAK_UPDATE=true ;;
			"--kernel-cleanup") ENABLE_KERNEL_CLEANUP=true ;;
			"--cache-clean") ENABLE_CACHE_CLEAN=true ;;
			"--run-hooks") ENABLE_HOOKS=true ;;
			"--dry-run") DRY_RUN=true ;;
			"--dry-run-hooks") DRY_RUN_HOOKS=true ;;
			"--no-dry-run-hooks") DRY_RUN_HOOKS=false ;;
			"--install") Create_Config; Create_Hook_Dirs; exit 0 ;;
			"--help") Show_Help; exit 0 ;;
			*) cecho "[FATAL] Unknown argument: $arg" red ; Show_Help ; exit 1 ;;
		esac
	done
}

Load_Config() {
	CURRENT_STEP="loading configuration"
	if [ -f "$CONFIG_FILE" ]; then
		cecho "[INFO] Loading configuration from $CONFIG_FILE" cyan
		# shellcheck disable=SC1090
		source "$CONFIG_FILE"
	else
		cecho "[INFO] No configuration file found at $CONFIG_FILE, using defaults" cyan
	fi
}

Create_Config() {
	CURRENT_STEP="creating configuration file"
	cat > "/etc/apt-up.conf" << 'EOT'
## VARIABLES ##
# Variables to export during update (space-separated list):
EXPORT_VARS="IGNORE_CC_MISMATCH=1"
# Defaults to GitLab kernel-firmware, which is upstream of kernel.org,
# but the kernel.org git is a more heavily scrutinized and conservative option:
# https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git
FIRMWARE_GIT_URL="https://gitlab.com/kernel-firmware/linux-firmware.git"

# Enable or disable specific features
ENABLE_FIRMWARE_UPDATE=true
ENABLE_SYSTEM_UPDATE=true
# ENABLE_DIST_UPGRADE=false  # WARNING: Only enable when performing major version upgrades
			     # Ensure /etc/apt/sources.list points to new release first
			     # Uses 'apt full-upgrade' instead of 'aptitude full-upgrade'
ENABLE_FLATPAK_UPDATE=true
ENABLE_KERNEL_CLEANUP=true
ENABLE_CACHE_CLEAN=true
ENABLE_HOOKS=true
# Run hook scripts in dry-run mode; IS_DRY_RUN=true is exported so hooks can
# check it and skip side effects. Set to false to only list hooks instead.
DRY_RUN_HOOKS=true

# Logging settings
LOG_FILE="/var/log/apt-up.log"
ENABLE_LOGGING=false

# Resource management (only applicable to non-interactive mode)
NICE_LEVEL=10
USE_IONICE=true
IONICE_CLASS=2
IONICE_LEVEL=7
EOT
cecho "[INFO] initial configuration created at /etc/apt-up.conf" cyan
}

Create_Hook_Dirs() {
	CURRENT_STEP="creating hook directories"
	mkdir -p "${HOOKS_DIR}/pre.d" "${HOOKS_DIR}/post.d" "${HOOKS_DIR}/fail.d" || Error_Handler
	cecho "[INFO] Created hook directories at ${HOOKS_DIR}" cyan
	CURRENT_STEP="setting hook directory permissions"
	chmod 755 "${HOOKS_DIR}" "${HOOKS_DIR}/pre.d" "${HOOKS_DIR}/post.d" "${HOOKS_DIR}/fail.d" || Error_Handler
	# Create a sample hook
	CURRENT_STEP="populating sample hook"
	cat > "${HOOKS_DIR}/pre.d/00-example" << 'EOT' || Error_Handler
#!/bin/bash
# Example pre-update hook for apt-up
#
# Hook naming:
#   Hooks run in lexical order. Prefix with NN- to control sequence.
#   Hooks with 'critical' in the name (e.g. 00-critical-check) will
#   abort the entire apt-up run if they exit non-zero.
#
# Dry-run awareness:
#   apt-up exports IS_DRY_RUN=true when run with --dry-run.
#   Check it here to skip side effects during dry runs.

if [ "${IS_DRY_RUN:-false}" = "true" ]; then
	echo "[DRY-RUN] 00-example: would perform pre-update actions"
	exit 0
fi

# Your pre-update actions go here.
exit 0
EOT
CURRENT_STEP="setting permissions on sample hook"
chmod 755 "${HOOKS_DIR}/pre.d/00-example" || Error_Handler
cecho "[INFO] Sample hook created at ${HOOKS_DIR}/pre.d/00-example" cyan
}

Apply_Resource_Limits() {
	CURRENT_STEP="applying resource limits"
	if [ "$INTERACTIVE" = "false" ]; then
		cecho "[INFO] Setting CPU priority (nice level: $NICE_LEVEL)" cyan
		renice -n "$NICE_LEVEL" -p $$ >/dev/null 2>&1 || Warn_Handler
		if [ "$USE_IONICE" = "true" ]; then
			if command -v ionice >/dev/null 2>&1; then
				cecho "[INFO] Setting I/O priority (class: $IONICE_CLASS, level: $IONICE_LEVEL)" cyan
				ionice -c "$IONICE_CLASS" -n "$IONICE_LEVEL" -p $$ >/dev/null 2>&1 || Warn_Handler
			else
				cecho "[WARNING] ionice command not found, skipping I/O priority adjustment" boldyellow
			fi
		fi
	fi
}

Run_Hooks() {
	CURRENT_STEP="running user-defined hooks"
	local hook_type="$1"
	if [ "$ENABLE_HOOKS" != "true" ]; then
		return 0
	fi
	local hooks_path="${HOOKS_DIR}/${hook_type}.d"
	if [ ! -d "$hooks_path" ]; then
		return 0
	fi
	cecho "[INFO] Running $hook_type hooks" cyan

	# In dry-run mode with hook execution disabled: list hooks without running them
	if [ "$DRY_RUN" = "true" ] && [ "${DRY_RUN_HOOKS:-true}" = "false" ]; then
		find "$hooks_path" -type f -executable | sort | while read -r hook; do
		hook_name=$(basename "$hook")
		cecho "[DRY-RUN] Would run hook: $hook_name" cyan
	done
	return 0
	fi

	# Execute hooks; in dry-run mode warn if a hook does not check IS_DRY_RUN
	find "$hooks_path" -type f -executable | sort | while read -r hook; do
	hook_name=$(basename "$hook")
	if [ "$DRY_RUN" = "true" ] && ! grep -q "IS_DRY_RUN" "$hook" 2>/dev/null; then
		cecho "[WARNING] Hook '$hook_name' does not check IS_DRY_RUN and may make unintended changes" boldyellow
	fi
	cecho "[INFO] Running hook: $hook_name" cyan
	"$hook"
	hook_status=$?  # Capture the hook's exit code immediately
	if [ "$hook_status" -ne 0 ]; then
		Warn_Handler
		if [[ "$hook_name" =~ ^[0-9][0-9]-critical- ]]; then
			cecho "[ERROR] Critical hook $hook_name failed with exit code $hook_status, aborting." red
			Error_Handler
		fi
	fi
done
}

Initialize_Logging() {
	if [ "$ENABLE_LOGGING" = "true" ]; then
		CURRENT_STEP="initializing logging"
		# Ensure log directory exists and is writable
		LOG_DIR=$(dirname "$LOG_FILE")
		if [ ! -d "$LOG_DIR" ]; then
			mkdir -p "$LOG_DIR" || {
				cecho "[WARNING] Could not create log directory $LOG_DIR, disabling logging" boldyellow
							ENABLE_LOGGING=false
							return
						}
		fi
		if [ ! -w "$LOG_DIR" ] || { [ -f "$LOG_FILE" ] && [ ! -w "$LOG_FILE" ]; }; then
			cecho "[WARNING] No write permission for $LOG_FILE, disabling logging" boldyellow
			ENABLE_LOGGING=false
			return
		fi
		# Add header to log file
		echo "==== apt-up run started at $(date) ====" >> "$LOG_FILE"
	fi
}

Detect_Bin_Paths ()
{
	CURRENT_STEP="detecting binary paths"
	# Detect all binaries silently; Sanity_Check determines consequences of absence
	# '|| true' prevents the ERR trap from firing when a binary isn't installed
	if [ -z "$DPKGBIN" ];    then DPKGBIN="$(command -v dpkg    2>/dev/null || true)"; fi
	if [ -z "$APTITUDEBIN" ]; then APTITUDEBIN="$(command -v aptitude 2>/dev/null || true)"; fi
	if [ -z "$APTBIN" ];     then APTBIN="$(command -v apt     2>/dev/null || true)"; fi
	if [ -z "$APTGETBIN" ];  then APTGETBIN="$(command -v apt-get  2>/dev/null || true)"; fi
	if [ -z "$FLATPAKBIN" ]; then FLATPAKBIN="$(command -v flatpak  2>/dev/null || true)"; fi
	if [ -z "$GITBIN" ];     then GITBIN="$(command -v git     2>/dev/null || true)"; fi
}

Sanity_Check ()
{
	CURRENT_STEP="performing sanity check"
	WE_ARE_SANE=true
	if [ ! -f "$DPKGBIN" ]; then
		cecho "[ERROR] The dpkg binary ($DPKGBIN) doesn't seem to exist." red
		echo "        Is this really a Debian-based system?"
		WE_ARE_SANE=false
	fi
	if [ ! -f "$APTGETBIN" ]; then
		cecho "[ERROR] The apt-get binary ($APTGETBIN) doesn't seem to exist." red
		echo "        Is this really a Debian-based system?"
		WE_ARE_SANE=false
	fi
	if [ ! -f "$APTBIN" ]; then
		cecho "[WARNING] apt binary not found; distribution upgrades will not be available." boldyellow
	fi
	if [ ! -f "$FLATPAKBIN" ] && [ "$ENABLE_FLATPAK_UPDATE" = "true" ]; then
		cecho "[INFO] flatpak is not installed, skipping flatpak updates." cyan
		ENABLE_FLATPAK_UPDATE=false
	fi
	if [ ! -f "$APTITUDEBIN" ]; then
		cecho "[ERROR] The aptitude binary ($APTITUDEBIN) doesn't seem to exist." red
		if [ "$INTERACTIVE" = "true" ]; then
			echo "        Aptitude is required by this script. Install now? [N/y]"
			read -r -p "==> " REPLY
			case "$REPLY" in
				( [yY]|[yY][eE][sS] )
					Install_Aptitude
					APTITUDEBIN="$(which aptitude)"  # Update after install
					if [ ! -f "$APTITUDEBIN" ]; then
						cecho "[ERROR] Failed to locate aptitude binary after installation." red
						Error_Handler
					fi
					;;
				*) echo ; Error_Handler ;;
			esac
		else
			cecho "[INFO] Non-interactive mode: Installing aptitude automatically." cyan
			Install_Aptitude
			APTITUDEBIN="$(which aptitude)"  # Update after install
			if [ ! -f "$APTITUDEBIN" ]; then
				cecho "[ERROR] Failed to locate aptitude binary after installation." red
				Error_Handler
			fi
		fi
	fi
	if [ "$ENABLE_FIRMWARE_UPDATE" = "true" ] && [ ! -f "$GITBIN" ]; then
		cecho "[ERROR] The git binary ($GITBIN) doesn't seem to exist." red
		if [ "$INTERACTIVE" = "true" ]; then
			echo "        Git is required for firmware updates. Install now? [N/y]"
			read -r -p "==> " REPLY
			case "$REPLY" in
				( [yY]|[yY][eE][sS] )
					( $APTITUDEBIN update && $APTITUDEBIN -y install git ) || Warn_Handler
					GITBIN="$(which git)"  # Update after install
					if [ ! -f "$GITBIN" ]; then
						cecho "[ERROR] Failed to locate git binary after installation." red
						cecho "[WARNING] Disabling firmware updates due to missing git." boldyellow
						ENABLE_FIRMWARE_UPDATE=false
					fi
					;;
				*)
					echo
					cecho "[WARNING] Disabling firmware updates due to missing git." boldyellow
					ENABLE_FIRMWARE_UPDATE=false
					;;
			esac
		else
			cecho "[INFO] Non-interactive mode: Firmware updates are enabled, installing git automatically." cyan
			( $APTITUDEBIN update && $APTITUDEBIN -y install git ) || {
				cecho "[WARNING] Failed to install git, disabling firmware updates." boldyellow
							ENABLE_FIRMWARE_UPDATE=false
						}
						if [ "$ENABLE_FIRMWARE_UPDATE" = "true" ]; then
							GITBIN="$(which git)"  # Update after install
							if [ ! -f "$GITBIN" ]; then
								cecho "[ERROR] Failed to locate git binary after installation." red
								cecho "[WARNING] Disabling firmware updates due to missing git." boldyellow
								ENABLE_FIRMWARE_UPDATE=false
							fi
						fi
		fi
	fi
	if [ "$WE_ARE_SANE" = "false" ]; then
		Error_Handler
	fi
}

Install_Aptitude ()
{
	CURRENT_STEP="installing aptitude"
	$APTGETBIN update || Warn_Handler
	$APTGETBIN -y install aptitude || Error_Handler
}

Update_Firmware ()
{
	CURRENT_STEP="updating firmware from linux-firmware"
	FIRMWARE_DIR="/var/cache/linux-firmware"
	# Sanity check on firmware directory
	if [ -e "$FIRMWARE_DIR" ] && [ ! -d "$FIRMWARE_DIR" ]; then
		cecho "[ERROR] $FIRMWARE_DIR exists but is not a directory." red
		Error_Handler
	elif [ -d "$FIRMWARE_DIR" ] && [ ! -w "$FIRMWARE_DIR" ]; then
		cecho "[ERROR] $FIRMWARE_DIR is not writable. Run as root or fix permissions." red
		Error_Handler
	fi
	OLD_HASH=""
	if [ -d "$FIRMWARE_DIR" ]; then
		cecho "[INFO] Checking for firmware updates..." cyan
		cd "$FIRMWARE_DIR" || Error_Handler
		OLD_HASH=$($GITBIN rev-parse HEAD)
		$GITBIN fetch --depth 1 origin main || Warn_Handler
		$GITBIN reset --hard origin/main || Warn_Handler
	else
		cecho "[INFO] Cloning linux-firmware repository from $FIRMWARE_GIT_URL..." cyan
		$GITBIN clone --depth 1 "$FIRMWARE_GIT_URL" "$FIRMWARE_DIR" || Error_Handler
		cd "$FIRMWARE_DIR" || Error_Handler
	fi
	NEW_HASH=$($GITBIN rev-parse HEAD)
	if [ "$OLD_HASH" != "$NEW_HASH" ]; then
		cecho "[INFO] New firmware detected, preparing installation..." cyan
		# Initialize counters
		SYMLINK_COUNT=0
		ENTRY_COUNT=0
		# Clean up broken and recursive symlinks first
		cecho "[INFO] Cleaning broken and recursive symlinks in /lib/firmware..." cyan
		while IFS= read -r link; do
			if ! readlink -e "$link" >/dev/null 2>&1; then
				[ "$ENABLE_LOGGING" = "true" ] && cecho "[INFO] Removing broken or recursive symlink: $link" cyan
				rm -f "$link" || Warn_Handler
				if [ ! -e "$link" ]; then
					SYMLINK_COUNT=$((SYMLINK_COUNT + 1))
				fi
			fi
		done < <(find /lib/firmware -type l -maxdepth 5 2>/dev/null)
		cecho "[INFO] Removed $SYMLINK_COUNT broken or recursive symlinks." cyan
		# Preemptively clear WHENCE destinations.
		# WHENCE uses both quoted ('File: "path"') and unquoted ('File: path') forms;
		# strip the prefix then optional surrounding quotes to handle both correctly.
		cecho "[INFO] Scanning for conflicts in /lib/firmware from WHENCE..." cyan
		TEMP_ENTRIES=$(mktemp)
		grep -E '^(RawFile|File):' WHENCE \
			| sed -E 's/^(RawFile|File):[[:space:]]*//' \
			| sed 's/^"//;s/"[[:space:]]*$//' \
			| sed 's/[[:space:]]*$//;s/\\//g' \
			> "$TEMP_ENTRIES"
					grep -E '^Link:' WHENCE \
						| sed -E 's/^Link:[[:space:]]*//' \
						| sed -E 's/[[:space:]]+->.*$//' \
						| sed 's/^"//;s/"[[:space:]]*$//' \
						| sed 's/[[:space:]]*$//;s/\\//g' \
						>> "$TEMP_ENTRIES"
											while read -r entry; do
												[ -z "$entry" ] && continue
												DEST_PATH="/lib/firmware/$entry"
												if [ -e "$DEST_PATH" ] || [ -L "$DEST_PATH" ]; then
													if [ -d "$DEST_PATH" ] && [ ! -L "$DEST_PATH" ]; then
														# Delete conflicting directory
														[ "$ENABLE_LOGGING" = "true" ] && cecho "[INFO] Removing conflicting directory: $DEST_PATH" cyan
														rm -rf "$DEST_PATH" || Warn_Handler
													else
														# File or symlink
														[ "$ENABLE_LOGGING" = "true" ] && cecho "[INFO] Removing file or symlink: $DEST_PATH" cyan
														rm -f "$DEST_PATH" || Warn_Handler
													fi
													if [ ! -e "$DEST_PATH" ]; then
														ENTRY_COUNT=$((ENTRY_COUNT + 1))
													fi
												fi
											done < "$TEMP_ENTRIES"
											rm -f "$TEMP_ENTRIES"
											if [ "$ENTRY_COUNT" -gt 0 ]; then
												cecho "[INFO] Cleared $ENTRY_COUNT files, symlinks, or directories from WHENCE entries." cyan
											else
												cecho "[INFO] No files, symlinks, or directories cleared from WHENCE entries." cyan
											fi
											# Final sweep: remove any remaining symlinks in /lib/firmware before reinstall.
											# Catches cases where an entry moved from File: to Link: between WHENCE versions,
											# leaving a regular file that copy-firmware.sh's 'ln -s' (no -f flag) collides with.
											STALE_SYMLINKS=$(find /lib/firmware -type l 2>/dev/null | wc -l)
											if [ "$STALE_SYMLINKS" -gt 0 ]; then
												find /lib/firmware -type l -delete 2>/dev/null || Warn_Handler
												cecho "[INFO] Removed $STALE_SYMLINKS remaining symlinks before reinstall." cyan
											fi
											# Run the firmware update
											cecho "[INFO] Installing firmware..." cyan
											./copy-firmware.sh /lib/firmware || Error_Handler
											CURRENT_STEP="updating initramfs for new firmware"
											cecho "[INFO] Updating initramfs..." cyan
											update-initramfs -k all -u 2>/dev/null || Error_Handler
										else
											cecho "[INFO] Firmware already up to date." cyan
	fi
}

Update_Firmware_DryRun() {
	CURRENT_STEP="checking firmware update status (dry-run)"
	FIRMWARE_DIR="/var/cache/linux-firmware"

	if [ ! -d "$FIRMWARE_DIR" ]; then
		cecho "[DRY-RUN] Would clone linux-firmware repository from $FIRMWARE_GIT_URL" cyan
		return 0
	fi

	cecho "[DRY-RUN] Checking for firmware updates..." cyan
	cd "$FIRMWARE_DIR" || Error_Handler

	# Get current local hash
	OLD_HASH=$($GITBIN rev-parse HEAD 2>/dev/null) || {
		cecho "[DRY-RUN] Would update existing firmware repository" cyan
			return 0
		}

	# Check remote without fetching using ls-remote
	REMOTE_HASH=$($GITBIN ls-remote "$FIRMWARE_GIT_URL" HEAD 2>/dev/null | awk '{print $1}') || {
		cecho "[DRY-RUN] Could not check remote firmware repository" yellow
			return 0
		}

		if [ -z "$REMOTE_HASH" ]; then
			cecho "[DRY-RUN] Could not determine remote firmware version" yellow
			return 0
		fi

		if [ "$OLD_HASH" != "$REMOTE_HASH" ]; then
			cecho "[DRY-RUN] New firmware available:" cyan
			cecho "[DRY-RUN]   Current: ${OLD_HASH:0:7}" cyan
			cecho "[DRY-RUN]   Remote:  ${REMOTE_HASH:0:7}" cyan
			cecho "[DRY-RUN] Would update firmware files in /lib/firmware" cyan
			cecho "[DRY-RUN] Would update initramfs for all kernels" cyan
		else
			cecho "[DRY-RUN] Firmware already up to date" cyan
		fi
	}

	Kernel_Cleanup() {
		CURRENT_STEP="removing unneeded kernels and headers"
		# Get current running kernel version
		CURRENT_KERNEL=$(uname -r)
		cecho "[INFO] Current running kernel: $CURRENT_KERNEL" cyan
		# Get all installed kernel image packages (excluding meta-packages)
		KERNEL_IMAGES=$($DPKGBIN --list | awk '/^ii  linux-image-[0-9]/ { print $2 }' | sort -V) || Bypass_Handler
		# Get all kernel meta packages to preserve them
		KERNEL_META_PACKAGES=$($DPKGBIN --list | awk '/^ii  linux-(image-)?[a-zA-Z]/ { if ($2 !~ /^linux-image-[0-9]/ && $2 !~ /^linux-headers-[0-9]/) print $2 }' | sort) || Bypass_Handler
		if [ -z "$KERNEL_IMAGES" ]; then
			cecho "[INFO] No versioned kernel packages found." cyan
			return 0
		fi
		# Find the latest kernel version (highest version number)
		LATEST_KERNEL=$(echo "$KERNEL_IMAGES" | sed 's/linux-image-//' | sort -V | tail -n 1)
		cecho "[INFO] Latest installed kernel: $LATEST_KERNEL" cyan
		# Determine which kernels to keep (always try to keep at least 2 for safety)
		KERNELS_TO_KEEP=""
		if [ "$CURRENT_KERNEL" = "$LATEST_KERNEL" ]; then
			# Current and latest are the same, find the second-newest kernel
			SECOND_LATEST=$(echo "$KERNEL_IMAGES" | sed 's/linux-image-//' | sort -V | tail -n 2 | head -n 1)
			if [ -n "$SECOND_LATEST" ] && [ "$SECOND_LATEST" != "$LATEST_KERNEL" ]; then
				KERNELS_TO_KEEP="$CURRENT_KERNEL $SECOND_LATEST"
				cecho "[INFO] Current kernel is latest, keeping: $CURRENT_KERNEL and previous: $SECOND_LATEST" cyan
			else
				# Only one kernel installed
				KERNELS_TO_KEEP="$CURRENT_KERNEL"
				cecho "[INFO] Only one kernel installed, keeping: $CURRENT_KERNEL" cyan
			fi
		else
			# Keep both current and latest
			KERNELS_TO_KEEP="$CURRENT_KERNEL $LATEST_KERNEL"
			cecho "[INFO] Keeping current kernel: $CURRENT_KERNEL and latest kernel: $LATEST_KERNEL" cyan
		fi
		# Build list of all packages to remove
		PACKAGES_TO_REMOVE=""
		# Process kernel images
		for kernel_pkg in $KERNEL_IMAGES; do
			kernel_version=${kernel_pkg#linux-image-}
			should_keep=false
			for keep_version in $KERNELS_TO_KEEP; do
				if [ "$kernel_version" = "$keep_version" ]; then
					should_keep=true
					break
				fi
			done
			if [ "$should_keep" = "false" ]; then
				PACKAGES_TO_REMOVE="$PACKAGES_TO_REMOVE $kernel_pkg"
				cecho "[INFO] Marking for removal: $kernel_pkg" cyan
			fi
		done
		# Process kernel headers - get all installed header packages
		HEADER_PACKAGES=$($DPKGBIN --list | awk '/^ii  linux-headers-[0-9]/ { print $2 }' | sort) || Bypass_Handler
		for header_pkg in $HEADER_PACKAGES; do
			should_keep=false

		# Check if this header package matches any kernel we want to keep
		for keep_version in $KERNELS_TO_KEEP; do
			# Extract the base kernel version (without architecture suffix)
			# e.g., 6.1.0-37-amd64 -> 6.1.0-37
			base_version=$(echo "$keep_version" | sed -E 's/-[^-]+$//')
			# Check if the header package matches either:
			# 1. The full kernel version (e.g., linux-headers-6.1.0-37-amd64)
			# 2. The base version + -common (e.g., linux-headers-6.1.0-37-common)
			if [ "$header_pkg" = "linux-headers-${keep_version}" ] || [ "$header_pkg" = "linux-headers-${base_version}-common" ]; then
				should_keep=true
				cecho "[INFO] Keeping headers for kernel $keep_version: $header_pkg" cyan
				break
			fi
		done
		if [ "$should_keep" = "false" ]; then
			PACKAGES_TO_REMOVE="$PACKAGES_TO_REMOVE $header_pkg"
			cecho "[INFO] Marking for removal: $header_pkg" cyan
		fi
	done
	# Clean up the package list (remove duplicates and extra spaces)
	PACKAGES_TO_REMOVE=$(echo $PACKAGES_TO_REMOVE | tr ' ' '\n' | sort -u | tr '\n' ' ' | sed 's/^ *//;s/ *$//')
	# Filter out any meta packages that might have been accidentally included
	if [ -n "$KERNEL_META_PACKAGES" ]; then
		FILTERED_PACKAGES=""
		for pkg in $PACKAGES_TO_REMOVE; do
			is_meta=false
			for meta_pkg in $KERNEL_META_PACKAGES; do
				if [ "$pkg" = "$meta_pkg" ]; then
					is_meta=true
					break
				fi
			done
			if [ "$is_meta" = "false" ]; then
				FILTERED_PACKAGES="$FILTERED_PACKAGES $pkg"
			fi
		done
		PACKAGES_TO_REMOVE=$(echo $FILTERED_PACKAGES | sed 's/^ *//;s/ *$//')
	fi
	if [ -n "$PACKAGES_TO_REMOVE" ]; then
		cecho "[INFO] Found old kernels and headers to remove:" boldcyan
		for pkg in $PACKAGES_TO_REMOVE; do
			cecho "[INFO]   - $pkg" cyan
		done
		if [ "$INTERACTIVE" = "true" ]; then
			echo
			cecho "[WARNING] About to remove the above packages. This will:" boldyellow
			cecho "          - Keep your current running kernel ($CURRENT_KERNEL) and its headers" boldyellow
			if [ "$CURRENT_KERNEL" != "$LATEST_KERNEL" ]; then
				cecho "          - Keep the latest installed kernel ($LATEST_KERNEL) and its headers" boldyellow
			else
				# Find the second kernel being kept
				SECOND_LATEST=$(echo "$KERNEL_IMAGES" | sed 's/linux-image-//' | sort -V | tail -n 2 | head -n 1)
				if [ -n "$SECOND_LATEST" ] && [ "$SECOND_LATEST" != "$LATEST_KERNEL" ]; then
					cecho "          - Keep the second-newest kernel version ($SECOND_LATEST) and its headers as fallback" boldyellow
				fi
			fi
			cecho "          - Remove all other kernel versions and their headers" boldyellow
			echo
			read -r -p "==> Continue with kernel cleanup? [Y/n] " REPLY
			case "$REPLY" in
				( [nN]|[nN][oO] ) 
					cecho "[INFO] Kernel cleanup skipped by user." cyan
					return 0
					;;
			esac
		fi
		# Use aptitude for removal to leverage its dependency resolution
		cecho "[INFO] Removing old kernel packages..." cyan
		if [ "$INTERACTIVE" = "true" ]; then
			$APTITUDEBIN purge $PACKAGES_TO_REMOVE || Warn_Handler
		else
			$APTITUDEBIN -y purge $PACKAGES_TO_REMOVE || Warn_Handler
		fi
	else
		cecho "[INFO] No old kernels or headers to remove." boldcyan
	fi
}

