	if [ "$DRY_RUN" = "true" ]; then
		UPGRADE_LIST=$($APTITUDEBIN -y -s full-upgrade 2>/dev/null | grep -E '^(Inst|Remv)') || Bypass_Handler
		if [ -n "$UPGRADE_LIST" ]; then
			cecho "[DRY-RUN] Packages that would be upgraded:" cyan
			echo "$UPGRADE_LIST" | head -n 15
			# grep -c outputs "0" when no matches, no need for || echo "0"
			UPGRADE_COUNT=$(echo "$UPGRADE_LIST" | grep -c '^Inst' || true)
