Dist_Upgrade() {
	CURRENT_STEP="performing distribution upgrade"

	# Check if sources.list exists and is readable
	if [ ! -r /etc/apt/sources.list ]; then
		cecho "[ERROR] Cannot read /etc/apt/sources.list" red
		Error_Handler
	fi

	# Provide warnings and guidance
	cecho "[WARNING] Distribution upgrade mode enabled" boldyellow
	cecho "[WARNING] This performs a major version upgrade using 'apt full-upgrade'" boldyellow
	echo
	cecho "[INFO] Before running a distribution upgrade, you should:" cyan
	cecho "       1. Update /etc/apt/sources.list to point to the new release" cyan
	cecho "       2. Backup your system and important data" cyan
	cecho "       3. Review the release notes for your distribution" cyan
	cecho "       4. Ensure you have adequate disk space" cyan
	cecho "       5. Consider running from a terminal multiplexer (tmux/screen)" cyan
	echo

	# Check if sources.list contains old/new release indicators
	# This is a heuristic check - we can't definitively determine if sources are "ready"
	# but we can warn if we see common patterns
	if grep -qE '^\s*deb.*\s+(oldstable|oldoldstable)\s+' /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null; then
		cecho "[WARNING] Sources may still reference old release codenames" boldyellow
		cecho "          Check your sources configuration before proceeding" boldyellow
		echo
	fi

	if [ "$INTERACTIVE" = "true" ]; then
		echo
		cecho "[IMPORTANT] Distribution upgrades can take considerable time and may require" boldmagenta
		cecho "            manual intervention for configuration file conflicts." boldmagenta
		echo
		read -r -p "==> Have you updated sources.list and are ready to proceed? [y/N] " REPLY
		case "$REPLY" in
			( [yY]|[yY][eE][sS] ) 
				cecho "[INFO] Proceeding with distribution upgrade..." cyan
				;;
			*)
				cecho "[INFO] Distribution upgrade cancelled by user." cyan
				cecho "[INFO] Update /etc/apt/sources.list when ready, then run with --dist-upgrade" cyan
				return 0
				;;
		esac
	else
		cecho "[WARNING] Running distribution upgrade in non-interactive mode" boldyellow
		cecho "[WARNING] This may fail if manual intervention is required" boldyellow
		cecho "[INFO] Consider running interactively for better control" cyan
	fi

	# Update package lists first
	cecho "[INFO] Updating package lists..." cyan
	$APTBIN update || {
		cecho "[ERROR] Failed to update package lists" red
			cecho "[ERROR] Check your sources.list configuration" red
			Error_Handler
		}

	# Perform minimal upgrade first (per Debian upgrade guide)
	cecho "[INFO] Performing minimal upgrade first..." cyan
	if [ "$INTERACTIVE" = "true" ]; then
		$APTBIN upgrade || {
			cecho "[ERROR] Minimal upgrade failed" red
					Error_Handler
				}
			else
				$APTBIN -y upgrade || {
					cecho "[ERROR] Minimal upgrade failed" red
									Error_Handler
								}
	fi

	# Now perform the full upgrade
	cecho "[INFO] Performing full distribution upgrade..." cyan
	cecho "[INFO] This may take a considerable amount of time..." cyan

	if [ "$INTERACTIVE" = "true" ]; then
		$APTBIN full-upgrade || {
			cecho "[ERROR] Distribution upgrade failed" red
					cecho "[ERROR] System may be in an inconsistent state" red
					cecho "[INFO] Run 'apt --fix-broken install' to attempt recovery" cyan
					Error_Handler
				}
			else
				# Non-interactive mode with DEBIAN_FRONTEND=noninteractive
				DEBIAN_FRONTEND=noninteractive $APTBIN -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" full-upgrade || {
					cecho "[ERROR] Distribution upgrade failed" red
									cecho "[ERROR] System may be in an inconsistent state" red
									cecho "[INFO] Run 'apt --fix-broken install' to attempt recovery" cyan
									Error_Handler
								}
	fi

	cecho "[INFO] Distribution upgrade completed successfully" boldgreen
	echo
	cecho "[INFO] Post-upgrade recommendations:" cyan
	cecho "       1. Reboot the system when convenient" cyan
	cecho "       2. Review system logs for any errors" cyan
	cecho "       3. Check for obsolete packages with: apt autoremove" cyan
	cecho "       4. Verify critical services are running correctly" cyan
	echo
}

Dist_Upgrade_DryRun() {
	CURRENT_STEP="simulating distribution upgrade (dry-run)"

	# Check if sources.list exists and is readable
	if [ ! -r /etc/apt/sources.list ]; then
		cecho "[DRY-RUN] Cannot read /etc/apt/sources.list" red
		return 1
	fi

	cecho "[DRY-RUN] Distribution upgrade simulation mode" boldcyan
	echo
	cecho "[DRY-RUN] Pre-upgrade checklist items to review:" cyan
	cecho "[DRY-RUN]   1. Update /etc/apt/sources.list to point to new release" cyan
	cecho "[DRY-RUN]   2. Backup system and important data" cyan
	cecho "[DRY-RUN]   3. Review release notes for your distribution" cyan
	cecho "[DRY-RUN]   4. Ensure adequate disk space available" cyan
	echo

	# Check for old release indicators
	if grep -qE '^\s*deb.*\s+(oldstable|oldoldstable)\s+' /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null; then
		cecho "[DRY-RUN] Sources may reference old release codenames" yellow
	fi

	# Update package lists
	cecho "[DRY-RUN] Downloading latest package lists from configured sources..." cyan
	$APTBIN update || {
		cecho "[DRY-RUN] Could not update package lists (check sources.list)" yellow
	}

	# Simulate minimal upgrade
	cecho "[DRY-RUN] Simulating minimal upgrade..." cyan
	$APTBIN -s upgrade 2>/dev/null | grep -E '^(Inst|Remv|Conf)' | head -n 10 || Bypass_Handler

	# Simulate full upgrade
	cecho "[DRY-RUN] Simulating full distribution upgrade..." cyan
	$APTBIN -s full-upgrade 2>/dev/null | grep -E '^(Inst|Remv|Conf)' | head -n 20 || Bypass_Handler

	# Summary - grep -c already outputs "0" when no matches, no need for || echo "0"
	UPGRADE_COUNT=$($APTBIN -s full-upgrade 2>/dev/null | grep -c '^Inst' || true)
	REMOVE_COUNT=$($APTBIN -s full-upgrade 2>/dev/null | grep -c '^Remv' || true)

	echo
	cecho "[DRY-RUN] Distribution upgrade summary:" boldcyan
	cecho "[DRY-RUN]   Packages to upgrade: $UPGRADE_COUNT" cyan
	cecho "[DRY-RUN]   Packages to remove: $REMOVE_COUNT" cyan
	cecho "[DRY-RUN] Would perform full upgrade using 'apt full-upgrade'" cyan
	cecho "[DRY-RUN] Would provide post-upgrade recommendations" cyan
	echo
}

