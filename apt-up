	fi
	CURRENT_STEP="updating flatpaks"
	if [ "$DRY_RUN" = "true" ]; then
		# Flatpak doesn't have a native dry-run, so we check for updates without applying
		cecho "[DRY-RUN] Checking for available Flatpak updates..." cyan
		# Running update without -y will show updates but prompt before installing
		# We'll capture the output to show what would be updated
		FLATPAK_UPDATES=$($FLATPAKBIN remote-ls --updates 2>/dev/null | head -n 10)
		if [ -n "$FLATPAK_UPDATES" ]; then
			cecho "[DRY-RUN] Available Flatpak updates:" cyan
			echo "$FLATPAK_UPDATES" | while read -r line; do
			cecho "[DRY-RUN]   $line" cyan
		done
		UPDATE_COUNT=$($FLATPAKBIN remote-ls --updates 2>/dev/null | wc -l)
		if [ "$UPDATE_COUNT" -gt 10 ]; then
			cecho "[DRY-RUN] ... and $((UPDATE_COUNT - 10)) more updates" cyan
		fi
	else
		cecho "[DRY-RUN] No Flatpak updates available" cyan
		fi
	elif [ "$INTERACTIVE" = "false" ]; then
		$FLATPAKBIN update -y || Warn_Handler
	else
		$FLATPAKBIN update || Warn_Handler
	fi
else
	Print_Header "Skipping flatpak updates..."
	if [ "$DRY_RUN" = "true" ]; then
		cecho "[DRY-RUN] Flatpak updates disabled or not installed" cyan
	else
		cecho "[INFO] Flatpak updates disabled or flatpak not installed." cyan
	fi
fi

if [ "$ENABLE_CACHE_CLEAN" = "true" ]; then
	if [ "$DRY_RUN" = "true" ]; then
		Print_Header "Checking apt cache size..."
	else
		Print_Header "Cleaning out the apt cache..."
	fi
	if [ "$DRY_RUN" = "true" ]; then
		CURRENT_STEP="checking cache size (dry-run)"
		# Calculate cache sizes
		APT_CACHE_SIZE=$(du -sh /var/cache/apt/archives 2>/dev/null | awk '{print $1}' || echo "unknown")
		APTITUDE_CACHE_SIZE=$(du -sh /var/cache/aptitude/pkgstates.old 2>/dev/null | awk '{print $1}' || echo "0")
		cecho "[DRY-RUN] Would clean apt cache (~$APT_CACHE_SIZE)" cyan
		cecho "[DRY-RUN] Would clean apt-get cache" cyan
		cecho "[DRY-RUN] Would clean aptitude cache" cyan
	else
		CURRENT_STEP="cleaning apt cache"
		$APTBIN clean || Warn_Handler
		CURRENT_STEP="cleaning apt-get cache"
		$APTGETBIN clean || Warn_Handler
		CURRENT_STEP="cleaning aptitude cache"
		$APTITUDEBIN clean || Warn_Handler
		cecho "[INFO] Finished cleaning cache." cyan
	fi
else
	Print_Header "Skipping cache cleaning..."
	if [ "$DRY_RUN" = "true" ]; then
		cecho "[DRY-RUN] Cache cleaning disabled" cyan
	else
		cecho "[INFO] Cache cleaning disabled." cyan
	fi
fi

if [ "$ENABLE_KERNEL_CLEANUP" = "true" ]; then
	if [ "$DRY_RUN" = "true" ]; then
		Print_Header "Checking old kernels..."
	else
		Print_Header "Purge old kernels & headers..."
	fi
	if [ "$DRY_RUN" = "true" ]; then
		Kernel_Cleanup_DryRun
	else
		Kernel_Cleanup
	fi
else
	Print_Header "Skipping kernel cleanup..."
	if [ "$DRY_RUN" = "true" ]; then
		cecho "[DRY-RUN] Kernel cleanup disabled" cyan
	else
		cecho "[INFO] Kernel cleanup disabled." cyan
	fi
fi

if [ "$ENABLE_FIRMWARE_UPDATE" = "true" ]; then
	if [ "$DRY_RUN" = "true" ]; then
		Print_Header "Checking firmware status..."
	else
		Print_Header "Updating kernel firmware..."
	fi
	if [ "$DRY_RUN" = "true" ]; then
		Update_Firmware_DryRun
	else
		Update_Firmware
	fi
else
	Print_Header "Skipping firmware updates..."
	if [ "$DRY_RUN" = "true" ]; then
		cecho "[DRY-RUN] Firmware updates disabled" cyan
	else
		cecho "[INFO] Firmware updates disabled." cyan
	fi
fi

if [ "$DRY_RUN" = "true" ]; then
	Print_Header "Dry-run complete..."
	cecho "[DRY-RUN] Would sync buffers to disk" cyan
else
	Print_Header "Syncing buffers out to disk..."
	CURRENT_STEP="syncing writes out to disk"
	if timeout 60s sync; then
		cecho "[INFO] Disk sync completed successfully." cyan
	else
		Warn_Handler
	fi
fi

if [ "$ENABLE_HOOKS" = "true" ]; then
	Print_Header "Running post-update scripts..."
	Run_Hooks "post"
else
	Print_Header "Skipping post-update scripts..."
	cecho "[INFO] Running hook scripts disabled." cyan
fi

# Close log file if enabled
if [ "$ENABLE_LOGGING" = "true" ]; then
	echo "==== apt-up run completed at $(date) ====" >> "$LOG_FILE"
fi

Print_Header "Finished."
